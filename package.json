{
  "name": "@upland/shared",
  "version": "0.5.0",
  "description": "Shared modules for the Upland Exhibits app suite. One repo, one tag-pinned package, subpath modules — apps update deliberately by bumping their pin.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./timing": {
      "types": "./dist/timing.d.ts",
      "default": "./dist/timing.js"
    },
    "./months": {
      "types": "./dist/months.d.ts",
      "default": "./dist/months.js"
    },
    "./palette": {
      "types": "./dist/palette.d.ts",
      "default": "./dist/palette.js"
    },
    "./dates": {
      "types": "./dist/dates.d.ts",
      "default": "./dist/dates.js"
    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "default": "./dist/mail.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit && node --test --import tsx test/*.test.ts",
    "lint": "npx oxlint src test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
